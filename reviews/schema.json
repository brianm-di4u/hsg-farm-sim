{
  "$comment": "Every critic, advocate and judge review ends with one fenced json block in this shape. The advocate's scores are its proposed corrections (at most ±1 from the critic mean per category); the judge's are final. Workstreams: WS1 render core and pixel pipeline, WS2 characters, WS3 environment art, WS4 lighting/weather/effects, WS5 animation and feel, WS6 UI/typography/mobile, WS7 era authenticity and research.",
  "type": "object",
  "required": [
    "loop",
    "role",
    "tier",
    "scores",
    "gaps"
  ],
  "properties": {
    "loop": {
      "type": "integer"
    },
    "role": {
      "enum": [
        "critic-claude",
        "critic-codex",
        "advocate",
        "judge"
      ]
    },
    "tier": {
      "type": "string",
      "pattern": "^T(16|24|32)$"
    },
    "scores": {
      "type": "object",
      "required": [
        "pixel",
        "characters",
        "environment",
        "lighting",
        "animation",
        "ui",
        "readability",
        "authenticity"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "score",
          "evidence"
        ],
        "properties": {
          "score": {
            "type": "number",
            "minimum": 1,
            "maximum": 10,
            "multipleOf": 0.5
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "shot"
              ],
              "properties": {
                "shot": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "expectedGain",
          "severity",
          "effort",
          "workstream",
          "fix"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^G-[a-z0-9-]+$"
          },
          "category": {
            "enum": [
              "pixel",
              "characters",
              "environment",
              "lighting",
              "animation",
              "ui",
              "readability",
              "authenticity"
            ]
          },
          "expectedGain": {
            "type": "number"
          },
          "severity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "effort": {
            "enum": [
              "S",
              "M",
              "L"
            ]
          },
          "workstream": {
            "enum": [
              "WS1",
              "WS2",
              "WS3",
              "WS4",
              "WS5",
              "WS6",
              "WS7"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "benchmark": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    },
    "verdict": {
      "enum": [
        "continue",
        "stop-pass",
        "stop-stagnant"
      ]
    }
  }
}